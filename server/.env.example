# Copie para .env e preencha. NUNCA versione o arquivo .env.
NODE_ENV=production
PORT=3000
# true quando estiver atrás de proxy/CDN (Nginx, Cloudflare, Render...) para obter o IP real.
TRUST_PROXY=true

DATABASE_URL=postgres://usuario:senha@localhost:5432/capital_city
DATABASE_SSL=false

# Endereço público do site/loja (o webhook do gateway aponta para cá).
PUBLIC_BASE_URL=https://capitalcityrp.com
# Origens extras autorizadas a chamar a API com cookie (ex.: domínio usado pelo launcher). Opcional.
CORS_ORIGINS=

# Login com Google: Client ID(s) OAuth do tipo "Aplicativo da Web" (público). Separe vários por vírgula
# (ex.: o do site e o do launcher Android).
GOOGLE_CLIENT_IDS=
# E-mails Google que viram administradores ao fazer login.
ADMIN_EMAILS=

# Gateway de pagamento BSPay.
PAYMENT_PROVIDER=bspay
PAYMENT_API_BASE_URL=https://api.bspay.co
PAYMENT_CLIENT_ID=investcapital26_lx0zcscghtsexndr
# Client Secret: somente aqui, no servidor.
PAYMENT_SECRET=
# Segredo aleatório (>= 24 caracteres) incluído na URL do webhook. Gere com: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
# IPs de origem do webhook, se o gateway informar (opcional).
PAYMENT_WEBHOOK_ALLOWED_IPS=
PAYMENT_EXPIRATION_MINUTES=30

# Chave usada pelo servidor SA-MP para consumir a fila de entregas. Gere com: openssl rand -hex 32
GAME_API_KEY=
# IP(s) do servidor do jogo (recomendado).
GAME_API_ALLOWED_IPS=

UPLOAD_DIR=uploads
